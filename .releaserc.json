{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/extension-workflows.js",
            "name": "extension-argoflow-<%= nextRelease.gitTag %>.js",
            "label": "ArgoFlow UI extension (<%= nextRelease.gitTag %>)"
          },
          {
            "path": "dist/extension.tar.gz",
            "name": "extension.tar.gz",
            "label": "ArgoFlow installer archive"
          },
          {
            "path": "dist/extension_checksums.txt",
            "name": "extension_checksums.txt",
            "label": "SHA-256 checksums"
          }
        ],
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
